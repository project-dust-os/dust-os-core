# Normalise line endings to LF in the repository, on every platform.
* text=auto eol=lf

# Source
*.c      text diff=c
*.h      text diff=c
*.S      text diff=asm
*.s      text diff=asm
*.ld     text
*.cmake  text
CMakeLists.txt text

# Documentation
*.md     text
*.txt    text

# Binary assets
*.efi    binary
*.EFI    binary
*.bin    binary
*.img    binary
*.iso    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary

# Keep vendor license files untouched
NOTICE   text
LICENSE  text

# ---------------------------------------------------------------------------
# Paths excluded from `git archive` snapshots.
#
# This is a release-export safety net, not a security boundary. The authoritative
# publication scope is DOCUMENTS/LICENSING.md; the procedure is
# DOCUMENTS/PUBLISHING.md. Keep this list in sync with the "Not published"
# section of that policy.
# ---------------------------------------------------------------------------
compat/                   export-ignore
crypto/                   export-ignore
firmware/                 export-ignore
test/                     export-ignore
bin/                      export-ignore
drivers/vendor/           export-ignore

# DOCUMENTS/ is published by default (ARCHITECTURE.md, LICENSING.md,
# PUBLISHING.md). Add a line here for any future document that must stay private.
