# EditorConfig — https://editorconfig.org
# Mirrors the project's .clang-format where the two overlap.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab
indent_size = 8

[*.{c,h,S,s,ld}]
# Kernel style: hard tabs, 8 columns, 80-column limit enforced by clang-format.
indent_style = tab
indent_size = 8
max_line_length = 80

[*.{md,markdown,txt}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.cmake]
indent_style = space
indent_size = 2

[CMakeLists.txt]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
