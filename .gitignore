/build/
/out/
obj/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CMakeUserPresets.json
compile_commands.json
*.ninja
*.o
*.obj
*.a
*.lib
*.d
*.elf
*.bin
*.iso
*.img
*.map
*.sym
*.lst

# ---------------------------------------------------------------------------
# Boot images and firmware blobs are build artifacts; they are not tracked.
# ---------------------------------------------------------------------------
*.efi
*.EFI
*.img.gz

# ---------------------------------------------------------------------------
# Editors and IDEs
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.clangd/
.cache/

# ---------------------------------------------------------------------------
# Operating system metadata
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Logs and local scratch files
# ---------------------------------------------------------------------------
*.log
*.tmp
*.bak

# ---------------------------------------------------------------------------
# Secrets and credentials — never commit these.
#
# This list is a safety net, not a guarantee. Use the approved secret store.
# If a secret is committed by accident, rotate it first, then clean history.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
secrets/
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.kdbx
id_rsa*
id_ecdsa*
id_ed25519*
*.asc
*.gpg
*.kubeconfig
*credentials*.json
*token*.json

# Crash dumps and memory images may contain customer data.
*.dmp
*.core
core

# Signed agreements and contract records are kept outside the repository.
LEGAL/signed/
contracts/
